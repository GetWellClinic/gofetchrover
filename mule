#!/bin/bash

# Function to display usage instructions
usage() {
  echo "Usage: $0 [setup|build|install]"
  exit 1
}

# Check for exactly one argument
if [ "$#" -ne 1 ]; then
  usage
fi

ACTION=$1

case "$ACTION" in
  setup)
    echo "Configuring Mule"
    ./bin/setup-mule.sh
    ;;
  build)
    echo "Building Mule"
    ./bin/mule-build.sh
    ;;
  install)
    echo "Installing Mule"
    ./bin/mule-install.sh
    ;;
  *)
    echo "Invalid option: $ACTION"
    usage
    ;;
esac
